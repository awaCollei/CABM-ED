layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/font_size = 16
placeholder_text = "curl -X POST {{base_url}}/audio/speech \\
  -H \"Authorization: Bearer {{api_key}}\" \\
  -H \"Content-Type: application/json\" \\
  -d \"{
    \"model\": \"{{model}}\",
    \"input\": \"{{input}}\",
    \"voice\": \"{{voice}}\",
    \"speed\": {{speed}}
  }\""

