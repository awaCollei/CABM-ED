[node name="AdvPlaceholderHint" type="Label" parent="ScrollContainer/VBoxContainer/AdvancedContainer" unique_id=95815906]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "可用占位符：
{{url}}：模型服务商的完整URL
{{base_url}}：模型服务商的基础URL
{{model}}：模型名
{{api_key}}：API密钥
{{input}}：需要TTS的文本
{{voice}}：保存的音色URI
{{speed}}：语速
{{ref_file}}：参考音频（文件）
{{ref_base64}}：参考音频（Base64）
{{ref_text}}：参考文本"
autowrap_mode = 1

